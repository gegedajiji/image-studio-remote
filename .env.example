# ── Backend ─────────────────────────────────────────────────────
APP_ID=local              # Application ID
APP_SECRET=               # Generate with: openssl rand -hex 32

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# The first locally registered account becomes the administrator.

# ── Transactional email ───────────────────────────────────────
# SMTP is preferred when complete; Resend remains available as another provider.
# For QQ Mail, enable SMTP in mailbox settings and use its authorization
# code (not the normal mailbox login password) as SMTP_PASSWORD.
REQUIRE_EMAIL_VERIFICATION=true
EMAIL_PROVIDER=auto
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=1468186089@qq.com
SMTP_PASSWORD=
SMTP_FROM=幻镜 AI <1468186089@qq.com>
EMAIL_TIMEOUT_MS=12000
RESEND_API_KEY=
RESEND_FROM=Mirage AI <noreply@example.com>

# ── Local uploads ─────────────────────────────────────────────
AVATAR_DIR=data/avatars
